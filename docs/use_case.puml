@startuml AttendanceSystem Use Case
left to right direction
skinparam packageStyle rectangle

actor "Студент" as Student
actor "Преподаватель" as Teacher
actor "Куратор / Деканат" as Admin

rectangle "Система учёта посещаемости" {

    ' ===== ОБЩИЕ =====
    usecase "Авторизация в системе" as UC_Login
    usecase "Просмотр расписания" as UC_Schedule

    ' ===== ФУНКЦИИ СТУДЕНТА =====
    usecase "Просмотр своей посещаемости" as UC_ViewOwn
    usecase "Получение уведомлений о пропусках" as UC_Notify

    ' ===== ФУНКЦИИ ПРЕПОДАВАТЕЛЯ =====
    usecase "Отметка посещаемости" as UC_Mark
    usecase "Редактирование отметки" as UC_Edit
    usecase "Просмотр посещаемости группы" as UC_ViewGroup
    usecase "Формирование отчёта по группе" as UC_Report

    ' ===== ФУНКЦИИ КУРАТОРА / ДЕКАНАТА =====
    usecase "Ведение справочников" as UC_Dict
    usecase "Управление расписанием" as UC_ManageSchedule
    usecase "Анализ систематических пропусков" as UC_Analysis
    usecase "Формирование сводного отчёта" as UC_ReportAdmin
}

' ==================================================
' СВЯЗИ АКТЁРОВ С ИХ ФУНКЦИЯМИ
' ==================================================

' --- Студент ---
Student --> UC_ViewOwn
Student --> UC_Notify

' --- Преподаватель ---
Teacher --> UC_Mark
Teacher --> UC_Edit
Teacher --> UC_ViewGroup
Teacher --> UC_Report

' --- Куратор / Деканат ---
Admin --> UC_Dict
Admin --> UC_ManageSchedule
Admin --> UC_Analysis
Admin --> UC_ReportAdmin
Admin --> UC_Notify

' ==================================================
' ОБЩИЕ ФУНКЦИИ (доступны всем)
' ==================================================

Student --> UC_Login
Teacher --> UC_Login
Admin --> UC_Login

Student --> UC_Schedule
Teacher --> UC_Schedule
Admin --> UC_Schedule

' ==================================================
' INCLUDE-СВЯЗИ: ВСЁ ТРЕБУЕТ АВТОРИЗАЦИИ
' ==================================================

UC_Schedule      ..> UC_Login : <<include>>
UC_ViewOwn       ..> UC_Login : <<include>>
UC_Notify        ..> UC_Login : <<include>>
UC_Mark          ..> UC_Login : <<include>>
UC_Edit          ..> UC_Login : <<include>>
UC_ViewGroup     ..> UC_Login : <<include>>
UC_Report        ..> UC_Login : <<include>>
UC_Dict          ..> UC_Login : <<include>>
UC_ManageSchedule ..> UC_Login : <<include>>
UC_Analysis      ..> UC_Login : <<include>>
UC_ReportAdmin   ..> UC_Login : <<include>>

' ==================================================
' ПРИМЕЧАНИЕ
' ==================================================
note bottom of UC_Login
  Все функции доступны пользователю
  только после успешной авторизации
  (связь <<include>>).
end note

@enduml
